# Plantilla de variables para infra/apps/compose.yml
# Copia este archivo como .env (mismo directorio) y completa los valores reales.
# NUNCA subas .env a GitHub (está excluido en .gitignore).
# Plantilla completa de todos los compose: ../.env.example

# ── Azure AD (Entra ID) — identificadores públicos del App Registration ──────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── CORS del BFF: URL(s) del frontend, separadas por coma ────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Base de datos (usadas por compose.yml) ───────────────────────────────────
ORACLE_HOST=
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=

# ── RabbitMQ (reservations y notify) ─────────────────────────────────────────
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ── Correo SMTP (ms-andesstay-notify) ────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
