# Plantilla de variables para infra/apps/compose.yml
# Copia este archivo como .env (mismo directorio) y completa los valores reales.
# NUNCA subas .env a GitHub (está excluido en .gitignore).
# Plantilla completa de todos los compose: ../.env.example

# ── Azure AD (Entra ID) — identificadores públicos del App Registration ──────
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── CORS del BFF: URL(s) del frontend, separadas por coma ────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── MySQL (contenedor mysql de compose.yml) ──────────────────────────────────
# Los mismos nombres que deploy/.env.example. MYSQL_APP_USER tiene que ser
# andesstay: deploy/mysql/init/01-schema.sql le da los permisos con ese nombre.
# openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_APP_USER=andesstay
MYSQL_DATABASE=andesstay

# ── RabbitMQ (reservations publica en el clúster de mq/compose.yml) ──────────
# Los mismos valores que el .env de mq/compose.yml. notify ya no se levanta
# aquí, así que el SMTP se configura en ese archivo.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ── Kafka ────────────────────────────────────────────────────────────────────
# Encendida por defecto en compose.yml. Ponerla en false solo para levantar
# los servicios sin el clúster de kafka/compose.yml.
# ANDESSTAY_EVENTS_KAFKA_ENABLED=true

# ── Perfil de ms-andesstay-kafka ─────────────────────────────────────────────
# Sin definir vale `demo`, que habilita POST /api/v1/kafka/pruebas/carga para
# generar lag visible en la demostracion. Dejarla VACIA --no comentada, vacia--
# apaga el perfil y esa ruta deja de existir, que es lo que corresponde en un
# entorno real.
# KAFKA_ADMIN_PERFIL=
