# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de infra/deploy/compose.yml
#
# En la práctica este archivo NO se copia a mano: el equipo mantiene una única
# copia en AndesStay/secrets/andesstay.env (compartida por OneDrive, fuera de
# todos los repositorios) y la lleva a la instancia con:
#
#   bash infra/deploy/scripts/push-env.sh
#
# que la deja en /opt/andesstay/.env con permisos 600.
#
# Se conserva aquí para documentar, dentro del repositorio, qué espera el
# compose. Los valores reales nunca se versionan.
#
# Uso del compose:
#   docker compose --env-file .env -f infra/deploy/compose.yml up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────────────────────────
# openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
MYSQL_APP_USER=andesstay
MYSQL_DATABASE=andesstay

# ── Cabecera compartida API Gateway -> nginx ─────────────────────────────────
# openssl rand -hex 32
GATEWAY_SECRET=

# ── Entra ID (identificadores públicos, no son secretos) ─────────────────────
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# ── Orígenes públicos, sin barra final ───────────────────────────────────────
# PUBLIC_WEB_ORIGIN alimenta CORS_ALLOWED_ORIGINS del BFF y el redirectUri de
# MSAL; PUBLIC_API_ORIGIN alimenta la CSP de nginx y el apiUri de la SPA.
PUBLIC_WEB_ORIGIN=
PUBLIC_API_ORIGIN=

# ── Instancia (las usa push-env.sh, no el compose) ───────────────────────────
EC2_PUBLIC_IP=
EC2_SSH_USER=ubuntu
EC2_SSH_KEY=
