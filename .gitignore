# --- Entorno y secretos: NUNCA versionar ---
.env
.env.*
!.env.example
*.pem
*.key
*.wallet
wallet/

# --- Volumenes y datos de contenedores ---
data/
volumes/
oradata/

# --- Editores ---
.idea/
.vscode/
*.iml

# --- Sistema operativo ---
.DS_Store
Thumbs.db

# Carpeta de secretos compartida del equipo. Vive fuera de los repositorios
# (AndesStay/secrets, sincronizada por OneDrive); esta regla solo cubre el caso
# de que alguien la copie dentro de un repo por error.
secrets/

# Credenciales del Learner Lab y estado de la infraestructura: pertenecen a cada
# integrante y a su propia cuenta AWS, nunca se comparten ni se versionan
deploy/credenciales-aws.txt
deploy/.estado-aws.env
deploy/.estado-aws.env.bak.*

# Postman explota la colección a su formato v3 --un fichero por petición-- al importarla, y sus
# rutas llegan a 268 caracteres. Windows corta en 260, así que ese directorio solo se puede
# versionar con core.longpaths activado, que es una configuración POR CLON: quien descargue la
# rama sin ponerla no puede ni hacer checkout. Se versiona el fichero único, que además se importa
# de una sola vez; el directorio queda como artefacto local de trabajo.
docs/evidencias/autorizacion/postman/
