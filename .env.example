# Copiar a .env y completar. El archivo .env NO se versiona.
# Lo usa mq/compose.yml (docker compose --env-file infra/.env -f infra/mq/compose.yml up -d) y el
# overlay mq/compose.e2e.yml. apps/compose.yml tiene su propia plantilla, apps/.env.example, y el
# despliegue en EC2 la suya, deploy/.env.example.
#
# Ya no hay variables de Oracle ni contraseñas por esquema: ningún compose las lee desde que los
# servicios pasaron a MySQL.

# --- RabbitMQ ---
RABBITMQ_USER=andesstay
RABBITMQ_PASSWORD=cambiar_esto

# --- Hosts de las instancias EC2: se reescriben cuando el Learner Lab reinicia ---
EC2_APPS_HOST=
EC2_DATA_HOST=
EC2_MQ_HOST=
EC2_KAFKA_HOST=

# --- Clustering de RabbitMQ: los dos nodos comparten esta cookie ---
RABBITMQ_ERLANG_COOKIE=cambiar_esto

# --- Identidad, para los microservicios levantados por los compose ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- SMTP de ms-andesstay-notify ---
# Sin definir, mq/compose.yml usa el Mailpit del propio compose (mailpit:1025, bandeja en
# http://localhost:8025), sin autenticación ni TLS. Es lo correcto en local, y por eso las cuatro
# van comentadas: antes MAIL_PORT=587 venía activo y, con MAIL_HOST vacío, notify quedaba
# apuntando a mailpit:587, un puerto cerrado, y ningún correo salía.
#
# Para un servidor real, descomentar y completar las cuatro.
# MAIL_HOST=smtp.ejemplo.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
#
# La demostración del fallo transitorio apunta MAIL_PORT a un puerto cerrado a propósito: cuatro
# intentos con backoff y después la DLQ. Ver docs/prueba-e2e-rabbitmq.md.

# --- Reintentos de notify: tres esperas en ms son cuatro intentos (opcional) ---
# NOTIFY_BACKOFF_LADDER=1000,2000,4000

# --- MySQL, para el overlay mq/compose.e2e.yml ---
# MYSQL_APP_USER tiene que ser andesstay: deploy/mysql/init/01-schema.sql le da los permisos
# con ese nombre.
MYSQL_ROOT_PASSWORD=cambiar_esto
MYSQL_DATABASE=andesstay
MYSQL_APP_USER=andesstay
MYSQL_APP_PASSWORD=cambiar_esto
