# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Oracle Free ---
ORACLE_PASSWORD=cambiar_esto
ORACLE_SERVICE=FREEPDB1
ORACLE_PORT=1521

# --- Contrasenas por esquema ---
RESERVATIONS_PASSWORD=cambiar_esto
CATALOG_PASSWORD=cambiar_esto
AUDIT_PASSWORD=cambiar_esto
REPORT_PASSWORD=cambiar_esto

# --- RabbitMQ ---
RABBITMQ_USER=andesstay
RABBITMQ_PASSWORD=cambiar_esto

# --- Hosts de las instancias EC2: se reescriben cuando el Learner Lab reinicia ---
EC2_APPS_HOST=
EC2_DATA_HOST=
EC2_MQ_HOST=
EC2_KAFKA_HOST=

# --- Host y usuario de Oracle, para los compose de apps/ ---
# En local, ORACLE_HOST=localhost. En EC2 se usa el valor de EC2_DATA_HOST.
ORACLE_HOST=localhost
ORACLE_USER=andesstay

# --- Clustering de RabbitMQ: los dos nodos comparten esta cookie ---
RABBITMQ_ERLANG_COOKIE=cambiar_esto

# --- Identidad, para los microservicios levantados por apps/compose.yml ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# --- SMTP de ms-andesstay-notify ---
# En local conviene un SMTP de pruebas como MailHog, no un servidor real.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=cambiar_esto
